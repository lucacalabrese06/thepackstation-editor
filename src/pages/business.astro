---
import Base from '../layouts/Base.astro';
import { load } from '../lib/server';
import { editor } from '../settings/editor';
import type { Business } from '../settings/types';

const business = await load<Business>(Astro, 'business');
const forms = await load<{ contactEndpoint: string }>(Astro, 'forms');
const error = 'error' in business ? business.error : 'error' in forms ? forms.error : '';
const pageData = !error && 'data' in business && 'data' in forms
  ? { business: { data: business.data, sha: business.sha }, forms: { data: forms.data, sha: forms.sha }, siteBase: editor.previewUrl }
  : null;
---
<Base title="Business details" section="business">
  <div class="head">
    <div style="display:flex;flex-direction:column;gap:6px"><h1>Business details</h1><p>Your name and contact details, used across every page.</p></div>
    {pageData && <button class="btn btn-primary" id="save" type="button">Save</button>}
  </div>
  <div id="problems" class="problems" role="alert" hidden></div>
  {pageData ? (
    <>
      <form class="form" id="bform" novalidate style="max-width:820px"></form>
      <script type="application/json" id="page-data" set:html={JSON.stringify(pageData)}></script>
    </>
  ) : <p class="loading-error" role="alert">{error}</p>}
</Base>

<script>
  import { clone, saveMany, uploadImage, previewUrl, esc, guardUnsaved } from '../scripts/editor';
  import type { Business } from '../settings/types';

  const raw = JSON.parse(document.getElementById('page-data')!.textContent!) as {
    business: { data: Business; sha: string };
    forms: { data: { contactEndpoint: string }; sha: string };
    siteBase: string;
  };
  const b = clone(raw.business.data);
  const f = clone(raw.forms.data);
  const startB = JSON.stringify(b);
  const startF = JSON.stringify(f);
  let logoPreview = '';
  guardUnsaved(() => JSON.stringify(b) !== startB || JSON.stringify(f) !== startF);

  const form = document.getElementById('bform') as HTMLFormElement;
  const DEFAULT_ICON = '<svg width="48" height="48" viewBox="0 0 40 40" aria-hidden="true"><defs><linearGradient id="dl" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#ff8ad8"/><stop offset=".35" stop-color="#8ad9ff"/><stop offset=".7" stop-color="#b8ff8a"/><stop offset="1" stop-color="#ffe98a"/></linearGradient></defs><rect x="7" y="2" width="26" height="36" rx="5" fill="url(#dl)"/><rect x="10" y="7" width="20" height="26" rx="3" fill="#16161C"/><circle cx="20" cy="20" r="5.2" fill="none" stroke="#FFD43B" stroke-width="2.4"/><path d="M14.8 20h10.4" stroke="#FFD43B" stroke-width="2.4"/></svg>';

  const input = (key: string, label: string, value: string, opts: { hint?: string; placeholder?: string; group?: string; type?: string } = {}) => `
    <div class="field"><label for="b-${key}">${label}</label>
      <input id="b-${key}" class="input" type="${opts.type ?? 'text'}" data-${opts.group ?? 'b'}="${key}" value="${esc(value)}" placeholder="${esc(opts.placeholder ?? '')}">
      ${opts.hint ? `<span class="hint">${opts.hint}</span>` : ''}</div>`;

  function render() {
    const logo = logoPreview || (b.logo ? raw.siteBase + b.logo : '');
    const icon = (size: number) => (logo ? `<img src="${esc(logo)}" alt="" style="width:${size}px;height:${size}px">` : DEFAULT_ICON.replace(/48/g, String(size)));
    form.innerHTML = `
      ${input('name', 'Business name', b.name)}
      ${input('strapline', 'Small line under the logo', b.strapline, { hint: 'Shown in capitals under the name in the website header.' })}
      ${input('tagline', 'One-line description', b.tagline, { hint: 'Shown in the footer and in Google results.' })}
      <div class="grid2">${input('email', 'Email', b.email, { type: 'email' })}${input('phone', 'Phone', b.phone, { hint: 'Optional. Leave empty to hide it.', type: 'tel' })}</div>
      <div class="grid2">${input('responseTime', 'How quickly you reply', b.responseTime, { placeholder: 'within 1 working day' })}${input('supportHours', 'Opening hours for support', b.supportHours)}</div>
      <div class="divider"></div><h2>Social links</h2>
      <div class="grid2">
        ${input('instagram', 'Instagram', b.social.instagram, { group: 's', placeholder: 'https://instagram.com/…' })}
        ${input('tiktok', 'TikTok', b.social.tiktok, { group: 's', placeholder: 'https://tiktok.com/@…' })}
      </div>
      ${input('facebook', 'Facebook', b.social.facebook, { group: 's', placeholder: 'https://facebook.com/…', hint: 'Leave any empty to hide that button. The first one filled in is used for "Follow for launch news".' })}
      <div class="divider"></div><h2>Logo and site icon</h2>
      <div class="icon-up">
        <div class="icon-box">${icon(48)}</div>
        <label class="drop" for="b-logo">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2"/><circle cx="9" cy="10" r="2"/><path d="m21 16-5-5-9 9"/></svg>
          <span style="display:flex;flex-direction:column;gap:4px;font-size:14px"><span><span style="color:var(--accent);font-weight:600" id="logo-label">${logo ? 'Change icon' : 'Upload an icon'}</span> or drag one here</span>
          <span style="font-size:12.5px;color:var(--muted)">Square works best, at least 512 × 512. PNG or JPG.</span></span>
        </label>
        <input id="b-logo" type="file" accept="image/png,image/jpeg,image/webp" class="sr">
      </div>
      ${b.logo ? '<button type="button" class="link-btn" style="align-self:flex-start" data-act="resetLogo">Go back to the original icon</button>' : ''}
      <div class="mocks"><span class="plabel">Where it shows</span>
        <div><div class="tabmock">${icon(16)}<span style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${esc(b.name)} · Pokémon card vending</span></div>
        <div class="headmock">${icon(32)}<span>${esc(b.name.toUpperCase())}</span></div></div>
        <span class="note">Browser tabs, phone home screens, the website header and footer, and Google results.</span>
      </div>
      <div class="divider"></div><h2>Launch</h2>
      <div class="grid2">
        <div class="field"><label for="b-launchStatus">Website status</label>
          <select id="b-launchStatus" class="input" data-b="launchStatus">
            <option value="coming-soon" ${b.launchStatus === 'coming-soon' ? 'selected' : ''}>Coming soon (yellow banner on)</option>
            <option value="live" ${b.launchStatus === 'live' ? 'selected' : ''}>Live (banner off, open to Google)</option>
          </select></div>
        ${input('launchWhen', 'Launch date text', b.launchWhen, { placeholder: 'Launching 2026' })}
      </div>
      ${input('launchMessage', 'Launch message', b.launchMessage)}
      <div class="divider"></div><h2>Contact form</h2>
      ${input('contactEndpoint', 'Formspree link', f.contactEndpoint, { group: 'form', placeholder: 'https://formspree.io/f/…', hint: 'Sign up free at formspree.io, create a form with your email address and paste its link here. Leave empty to keep the form in preview mode.' })}
      <div class="divider"></div><h2>Website address</h2>
      ${input('website', 'Web address', b.website, { hint: 'Only change this if the domain changes. No slash at the end.' })}`;
  }

  form.addEventListener('input', (e) => {
    const t = e.target as HTMLInputElement;
    if (t.dataset.b) (b as unknown as Record<string, string>)[t.dataset.b] = t.value;
    if (t.dataset.s) (b.social as Record<string, string>)[t.dataset.s] = t.value.trim();
    if (t.dataset.form) f.contactEndpoint = t.value.trim();
  });
  form.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('[data-act=resetLogo]')) { b.logo = ''; logoPreview = ''; render(); }
  });
  form.addEventListener('change', async (e) => {
    const t = e.target as HTMLInputElement;
    if (t.id === 'b-launchStatus') b.launchStatus = t.value as Business['launchStatus'];
    if (t.id !== 'b-logo' || !t.files?.[0]) return;
    const fileIn = t.files[0];
    logoPreview = previewUrl(fileIn);
    render();
    const label = document.getElementById('logo-label');
    if (label) label.textContent = 'Uploading…';
    const path = await uploadImage(fileIn, 'logo', 'logo');
    if (path) b.logo = path; else logoPreview = '';
    render();
  });
  form.addEventListener('submit', (e) => e.preventDefault());

  document.getElementById('save')?.addEventListener('click', (e) => {
    for (const k of ['name', 'strapline', 'tagline', 'email', 'phone', 'responseTime', 'supportHours', 'launchWhen', 'launchMessage', 'website'] as const) b[k] = (b[k] ?? '').trim();
    const logoChanged = JSON.parse(startB).logo !== b.logo;
    saveMany(
      [
        { file: 'business', data: b, sha: raw.business.sha, changed: JSON.stringify(b) !== startB },
        { file: 'forms', data: f, sha: raw.forms.sha, changed: JSON.stringify(f) !== startF },
      ],
      logoChanged ? 'Updated business details and logo' : 'Updated business details',
      e.currentTarget as HTMLButtonElement,
    );
  });

  render();
</script>
