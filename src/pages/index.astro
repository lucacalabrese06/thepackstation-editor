---
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';

if (Astro.locals.user) return Astro.redirect('/machines');

const params = Astro.url.searchParams;
const who = params.get('who') ?? '';
const messages: Record<string, string> = {
  state: 'That sign-in link had expired. Please try again.',
  github: "GitHub sign-in didn't complete. Please try again.",
  access: `The GitHub account ${who ? `"${who}" ` : ''}doesn't have access to edit the website. Ask the owner to add you on GitHub, or sign in with a different account.`,
};
const error = messages[params.get('error') ?? ''];
const note = params.has('expired') ? 'Your sign-in has expired. Please sign in again.' : params.has('signedout') ? "You've signed out." : '';
---
<Base title="Sign in">
  <div class="signin">
    <div class="signin-card">
      <Logo size={64} />
      <div style="display:flex;flex-direction:column;gap:8px">
        <h1>The Pack Station editor</h1>
        <p>Update machines, wording and photos on thepackstation.co.uk. No code needed.</p>
      </div>
      {error && <p role="alert" class="problems" style="text-align:left">{error}</p>}
      {note && !error && <p role="status" class="note" style="color:var(--soft)">{note}</p>}
      <a class="btn btn-primary btn-block" href="/api/login">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-3.2 19.5c.5.1.7-.2.7-.5v-1.7c-2.8.6-3.4-1.3-3.4-1.3-.5-1.2-1.1-1.5-1.1-1.5-.9-.6.1-.6.1-.6 1 .1 1.5 1 1.5 1 .9 1.6 2.4 1.1 3 .9.1-.7.4-1.1.6-1.4-2.2-.3-4.6-1.1-4.6-5 0-1.1.4-2 1-2.7-.1-.3-.4-1.3.1-2.7 0 0 .8-.3 2.8 1a9.7 9.7 0 0 1 5 0c1.9-1.3 2.8-1 2.8-1 .5 1.4.2 2.4.1 2.7.6.7 1 1.6 1 2.7 0 3.9-2.3 4.7-4.6 5 .4.3.7.9.7 1.9V21c0 .3.2.6.7.5A10 10 0 0 0 12 2z"></path></svg>
        Sign in with GitHub
      </a>
      <p class="note">Only people with access to the website on GitHub can sign in.</p>
    </div>
  </div>
</Base>
