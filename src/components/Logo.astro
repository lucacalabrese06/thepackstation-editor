---
interface Props {
  size?: number;
}
const { size = 30 } = Astro.props;
const id = `logo-${size}`;
---
<svg width={size} height={size} viewBox="0 0 40 40" aria-hidden="true">
  <defs>
    <linearGradient id={id} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#ff8ad8" />
      <stop offset=".35" stop-color="#8ad9ff" />
      <stop offset=".7" stop-color="#b8ff8a" />
      <stop offset="1" stop-color="#ffe98a" />
    </linearGradient>
  </defs>
  <rect x="7" y="2" width="26" height="36" rx="5" fill={`url(#${id})`} />
  <rect x="10" y="7" width="20" height="26" rx="3" fill="#16161C" />
  <circle cx="20" cy="20" r="5.2" fill="none" stroke="#FFD43B" stroke-width="2.4" />
  <path d="M14.8 20h10.4" stroke="#FFD43B" stroke-width="2.4" />
</svg>
